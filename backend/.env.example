# CobraQ Environment Variables
# Copy to .env and fill in values

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_32CHARS

# Anthropic API Key for Claude Vision
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# App settings
APP_NAME=CobraQ
DEBUG=false

# Optional storage/profile configuration (all paths are absolute after loading)
# COBRAQ_DATA_DIR=C:/path/to/CobraQ/backend/data
# COBRAQ_RESEARCH_ROOT=C:/path/to/CobraQ/research
COBRAQ_PROFILE=local
COBRAQ_EXTERNAL_AI_ENABLED=true
COBRAQ_VECTOR_ENABLED=true
COBRAQ_MAX_UPLOAD_BYTES=104857600
COBRAQ_MAX_DOCUMENT_PAGES=300
COBRAQ_EXTRACTION_TIMEOUT=900
COBRAQ_OCR_PAGE_TIMEOUT=45
# OCR uses an installed local Tesseract binary and vie/eng language data.
# COBRAQ_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# COBRAQ_TESSDATA_DIR=C:/path/to/tessdata
# To use a different .env file, set COBRAQ_ENV_FILE before starting Python.
# Generate the sandbox with setup_sandbox.bat instead of editing these to point at real data.

# Admin account (created on first run via create_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

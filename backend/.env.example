# CobraQ Environment Variables
# Copy to .env and fill in values
# DO NOT COMMIT .env — it's in .gitignore

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_64CHARS

# ── AI Provider: GROK (xAI) — primary ──────────────────────────
# Get free $25/mo credits: https://console.x.ai/
# After creating key, set GROK_API_KEY below
GROK_API_KEY=xai-YOUR_KEY_HERE

# ── Optional: OpenAI-compatible fallback ───────────────────────
# Uncomment + fill if you want to use OpenAI/DeepSeek/other instead
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Optional: Anthropic Claude (for PDF vision parsing) ────────
# Only needed if you upload scanned-PDF quizzes (image-based)
# ANTHROPIC_API_KEY=sk-ant-...

# App settings
APP_NAME=CobraQ
DEBUG=false
PORT=10000

# Admin account (created on first run via create_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
# CobraQ Environment Variables
# Copy to .env and fill in values

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_32CHARS

# Anthropic API Key for Claude Vision
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# App settings
APP_NAME=CobraQ
DEBUG=false

# Admin account (created on first run via create_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

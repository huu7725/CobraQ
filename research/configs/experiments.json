{
  "schema_version": "1.0",
  "research_questions": {
    "RQ1": "RAG có làm giảm tỷ lệ sai dữ kiện lịch sử so với SLM không truy xuất hay không?",
    "RQ2": "LoRA có cải thiện chất lượng câu hỏi của SLM với chi phí thấp hơn tinh chỉnh toàn phần hay không?",
    "RQ3": "CobraQ có tạo được câu hỏi đạt yêu cầu chuyên môn và sư phạm của giáo viên hay không?"
  },
  "shared": {
    "base_model": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
    "corpus_id": "history12_kntt_2023_sample",
    "collection": "cobraq_history12_kntt_v1",
    "embedding_model": "intfloat/multilingual-e5-small",
    "retrieval_mode": "hybrid",
    "retrieval_top_k": 5,
    "rerank_top_n": 3,
    "seed": 42,
    "decoding": {
      "temperature": 0.2,
      "top_p": 0.9,
      "max_new_tokens": 768,
      "do_sample": true
    },
    "lora": {
      "rank": 16,
      "alpha": 32,
      "dropout": 0.05,
      "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
      "learning_rate": 0.0002,
      "epochs": 3,
      "gradient_accumulation_steps": 8,
      "warmup_ratio": 0.05
    }
  },
  "conditions": [
    {
      "id": "C0",
      "name": "Base SLM",
      "use_rag": false,
      "use_lora": false,
      "purpose": "Baseline không truy xuất, không tinh chỉnh"
    },
    {
      "id": "C1",
      "name": "Base SLM + RAG",
      "use_rag": true,
      "use_lora": false,
      "purpose": "Đo riêng tác động của RAG"
    },
    {
      "id": "C2",
      "name": "LoRA SLM",
      "use_rag": false,
      "use_lora": true,
      "adapter_path": "artifacts/adapters/history12_lora",
      "purpose": "Đo riêng tác động của LoRA"
    },
    {
      "id": "C3",
      "name": "LoRA SLM + RAG",
      "use_rag": true,
      "use_lora": true,
      "adapter_path": "artifacts/adapters/history12_lora",
      "purpose": "Cấu hình CobraQ hoàn chỉnh"
    }
  ],
  "evaluation": {
    "questions_per_condition": 40,
    "teacher_raters": 3,
    "blind_review": true,
    "primary_metrics": [
      "factual_error_rate",
      "fact_support_rate",
      "teacher_acceptance_rate",
      "teacher_weighted_score",
      "latency_p50_ms",
      "latency_p95_ms",
      "peak_vram_mb"
    ],
    "secondary_metrics": [
      "recall_at_5",
      "mrr",
      "ndcg_at_5",
      "bertscore_f1",
      "rouge_l",
      "bleu"
    ]
  }
}
